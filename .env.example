# Copy file này thành .env.local và điền giá trị thật.

# Connection string PostgreSQL (pooled) - dùng cho runtime
DATABASE_URL="postgresql://app:app@localhost:5432/vnpt_landing"
# Connection string trực tiếp - dùng cho Prisma migrate
DIRECT_URL="postgresql://app:app@localhost:5432/vnpt_landing"

# Khoá ký JWT cho phiên đăng nhập admin
JWT_SECRET="60bd8bc4e9ffdd81f0ec5d80865634046809cea47924a8659bfa3c287831187e"

# ID Google Tag Manager
NEXT_PUBLIC_GTM_ID=""
# ID Facebook Pixel
NEXT_PUBLIC_FB_PIXEL_ID=""

# Webhook Zalo Notification Service (Zalo OA) nhận thông báo lead mới
LEAD_NOTIFY_ZALO_WEBHOOK_URL=""
# Access token của Zalo Official Account dùng để gửi tin nhắn thông báo
ZALO_OA_ACCESS_TOKEN=""
